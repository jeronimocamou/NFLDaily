{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "site",
  "functions": {
    "api/*.js": { "includeFiles": "puzzles/**" }
  },
  "headers": [
    {
      "source": "/(app.js|style.css|index.html)?",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
